# ===================================================================
# StyleRadar - PT8080-VirtualTryOn-Service (ms-probador-virtual)
# Plantilla Completa de Variables de Entorno (.env.example)
# Squad Portal8080 · DOSW 2026 · Referencia Estandarizada
#
# INSTRUCCIONES:
# Copia este archivo a '.env' para desarrollo local:
#   cp .env.example .env
# NUNCA subas el archivo '.env' con secretos al repositorio Git.
# ===================================================================

# -------------------------------------------------------------------
# Configuración del Microservicio
# -------------------------------------------------------------------
SERVER_PORT=8500
SPRING_PROFILES_ACTIVE=dev
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# -------------------------------------------------------------------
# Integración con Otros Microservicios (REST Síncrono)
# -------------------------------------------------------------------
USUARIOS_SERVICE_URL=http://localhost:8120
USUARIOS_MEASUREMENTS_PATH=/api/v1/internal/users/{userId}/measurements
USUARIOS_INTERNAL_AUTH_USERNAME=internal_probador
USUARIOS_INTERNAL_AUTH_PASSWORD=internal_secret_password
CATALOGO_SERVICE_URL=http://localhost:8220

# -------------------------------------------------------------------
# Persistencia PostgreSQL (probador_db) y Migraciones Flyway
# -------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/probador_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5442
DB_NAME=probador_db
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# -------------------------------------------------------------------
# Caching y Volátiles Redis
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PORT_EXTERNAL=6389
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# -------------------------------------------------------------------
# Broker de Mensajería RabbitMQ y Sincronización de Catálogo
# -------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MGMT_PORT_EXTERNAL=15672

TRYON_AMQP_LISTENERS_ENABLED=true
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000

# Retries AMQP
TRYON_AMQP_RETRY_MAX_ATTEMPTS=4
TRYON_AMQP_RETRY_INITIAL_INTERVAL_MS=2000
TRYON_AMQP_RETRY_MULTIPLIER=2.0
TRYON_AMQP_RETRY_MAX_INTERVAL_MS=10000

# Exchanges, Queues y Enrutamiento AMQP
CATALOG_EXCHANGE=styleradar.exchange
CATALOG_GARMENT_QUEUE=styleradar.probador.prenda-publicada.q
CATALOG_GARMENT_ROUTING_KEY=styleradar.catalogo.prenda.publicada
CATALOG_WITHDRAWN_QUEUE=styleradar.probador.prenda-retirada.q
CATALOG_WITHDRAWN_ROUTING_KEY=styleradar.catalogo.prenda.retirada
CATALOG_MODERATION_QUEUE=styleradar.probador.moderacion-cambiada.q
CATALOG_MODERATION_ROUTING_KEY=styleradar.catalogo.moderacion.cambiada
USER_EXCHANGE=styleradar.exchange
USER_ACCOUNT_DELETED_QUEUE=styleradar.probador.cuenta-eliminada.q
USER_ACCOUNT_DELETED_ROUTING_KEY=styleradar.usuarios.cuenta.eliminada
USER_ACCOUNT_DELETED_DLQ=styleradar.probador.cuenta-eliminada.dlq
CATALOG_DLX=styleradar.dlx
CATALOG_GARMENT_DLQ=styleradar.probador.dlq
CATALOG_GARMENT_DLQ_ROUTING_KEY=styleradar.probador.dlq
TRYON_EXCHANGE=styleradar.exchange
TRYON_PROCESS_QUEUE=q.tryon.job.process
TRYON_DLX=styleradar.dlx
TRYON_PROCESS_DLQ=q.tryon.job.process.dlq

# -------------------------------------------------------------------
# Proveedor de Inteligencia Artificial (Virtual Try-On)
# dev/test/swagger usan 'mock'. QA y producción fuerzan 'fashn' y requieren
# FASHN_API_KEY inyectada por el gestor de secretos.
# -------------------------------------------------------------------
TRYON_AI_PROVIDER=mock
TRYON_DAILY_QUOTA_LIMIT=10
TRYON_MONTHLY_QUOTA_LIMIT=10
TRYON_ESTIMATED_PROCESSING_DURATION=PT25S
FASHN_API_URL=https://api.fashn.ai/v1
FASHN_API_KEY=tu_api_key_de_fashn_aqui
FASHN_TOTAL_TIMEOUT=PT25S

# Limpieza periódica de trabajos estancados
STALE_JOB_SWEEP_ENABLED=true
STALE_JOB_SWEEP_INTERVAL_MS=60000
STALE_JOB_INITIAL_DELAY_MS=10000
STALE_JOB_MAX_PROCESSING_AGE_MINUTES=10

# -------------------------------------------------------------------
# Seguridad, Red y Autenticación Bearer JWT (RFC 7519 / OWASP)
# Generar con: openssl rand -base64 32
# -------------------------------------------------------------------
JWT_SECRET_BASE64=cmVlbXBsYXphcl9jb25fc2VjcmV0b19qd3RfYmFzZTY0X2RlX21pbmltb18yNTZfYml0cw==
JWT_DURATION=PT60M
TRYON_TRUSTED_PROXIES=127.0.0.1,::1
ALLOW_LOCALHOST_URLS=false
SAFE_PHOTO_URL_ALLOWED_HOSTS=styleradarpt8080blob.blob.core.windows.net,styleradar-virtualtryon-qa.azurewebsites.net,raw.githubusercontent.com

# -------------------------------------------------------------------
# Almacenamiento Azure Blob Storage REST API (Siluetas Biométricas)
# -------------------------------------------------------------------
AZURE_STORAGE_BASE_URL=https://styleradarpt8080blob.blob.core.windows.net
AZURE_STORAGE_CONTAINER=biometric-silhouettes
AZURE_STORAGE_ACCOUNT_KEY=reemplazar_con_clave_base64_de_la_cuenta_de_storage
AZURE_READ_SAS_DURATION=PT15M
AZURE_STORAGE_API_VERSION=2024-11-04

# -------------------------------------------------------------------
# Observabilidad, Actuator y Métricas Prometheus (Health / Metrics)
# -------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
APP_GIT_COMMIT_SHA=dev-local
