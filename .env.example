# ===================================================================
# StyleRadar - PT8080-VirtualTryOn-Service (ms-probador-virtual)
# Plantilla de Variables de Entorno (.env.example)
# Squad Portal8080 · DOSW 2026
#
# INSTRUCCIONES:
# Copia este archivo a '.env' para desarrollo local:
#   cp .env.example .env
# NUNCA subas el archivo '.env' con secretos al repositorio Git.
# ===================================================================

# -------------------------------------------------------------------
# Configuración del Microservicio
# -------------------------------------------------------------------
SERVER_PORT=8500
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# Persistencia PostgreSQL (probador_db) y Migraciones Flyway
# -------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5442
DB_NAME=probador_db
FLYWAY_ENABLED=true

# -------------------------------------------------------------------
# Caching y Volátiles Redis
# -------------------------------------------------------------------
REDIS_PORT_EXTERNAL=6389

# -------------------------------------------------------------------
# Broker de Mensajería RabbitMQ y Sincronización de Catálogo
# -------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MGMT_PORT_EXTERNAL=15672
TRYON_AMQP_LISTENERS_ENABLED=true
CATALOG_EVENTS_EXCHANGE=styleradar.catalog.events
CATALOG_GARMENT_QUEUE=q.tryon.catalog.garment.updated
CATALOG_GARMENT_ROUTING_KEY=catalog.garment.updated
CATALOG_EVENTS_DLX=styleradar.catalog.dlx
CATALOG_GARMENT_DLQ=q.tryon.catalog.garment.updated.dlq
CATALOG_GARMENT_DLQ_ROUTING_KEY=catalog.garment.updated.dead

# -------------------------------------------------------------------
# Proveedor de Inteligencia Artificial (Virtual Try-On)
# dev/test/swagger usan 'mock'. QA y producción fuerzan 'fashn' y requieren
# FASHN_API_KEY inyectada por el gestor de secretos.
# -------------------------------------------------------------------
TRYON_AI_PROVIDER=mock
FASHN_API_URL=https://api.fashn.ai/v1
FASHN_API_KEY=tu_api_key_de_fashn_aqui

# -------------------------------------------------------------------
# Seguridad y Autenticación Bearer JWT (HS256 - mínimo 256 bits Base64)
# Generar con: openssl rand -base64 32
# -------------------------------------------------------------------
JWT_SECRET_BASE64=reemplazar_con_secreto_jwt_base64_de_minimo_256_bits
JWT_DURATION=PT60M

# -------------------------------------------------------------------
# Almacenamiento Azure Blob Storage REST API (Siluetas Biométricas)
# -------------------------------------------------------------------
AZURE_STORAGE_BASE_URL=https://<tu-cuenta-storage>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=biometric-silhouettes
AZURE_STORAGE_ACCOUNT_KEY=reemplazar_con_clave_base64_de_la_cuenta_de_storage
AZURE_READ_SAS_DURATION=PT60M
AZURE_STORAGE_API_VERSION=2024-11-04

