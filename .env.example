# ===================================================================
# StyleRadar - PT8080-VirtualTryOn-Service (ms-probador-virtual)
# Plantilla de Variables de Entorno (.env.example)
# Squad Portal8080 · DOSW 2026
#
# INSTRUCCIONES:
# Copia este archivo a '.env' para desarrollo local:
#   cp .env.example .env
# NUNCA subas el archivo '.env' con secretos al repositorio Git.
# ===================================================================

# -------------------------------------------------------------------
# Configuración del Microservicio
# -------------------------------------------------------------------
SERVER_PORT=8500
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# Persistencia PostgreSQL (probador_db)
# -------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5442
DB_NAME=probador_db

# -------------------------------------------------------------------
# Caching y Volátiles Redis
# -------------------------------------------------------------------
REDIS_PORT_EXTERNAL=6389

# -------------------------------------------------------------------
# Broker de Mensajería RabbitMQ
# -------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MGMT_PORT_EXTERNAL=15672

# -------------------------------------------------------------------
# Proveedor de Inteligencia Artificial (Virtual Try-On)
# Valores soportados: 'mock' (costo $0 USD) | 'fashn' (SaaS real)
# -------------------------------------------------------------------
TRYON_AI_PROVIDER=mock
FASHN_API_URL=https://api.fashn.ai/v1
FASHN_API_KEY=tu_api_key_de_fashn_aqui

# -------------------------------------------------------------------
# Almacenamiento Azure Blob (Fotos Temporales con TTL 15min)
# -------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=styleradarstorage
AZURE_STORAGE_CONTAINER=tryon-photos
AZURE_SAS_TOKEN=tu_sas_token_aqui

